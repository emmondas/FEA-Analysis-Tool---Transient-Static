        % Button pushed function: SolveButton
        function SolveButtonPushed(app, event)
            if isempty(app.Geometry)
                uialert(app.UIFigure, ...
                    'Upload an STL file before solving.', 'No geometry');
                return
            end
 
            isTransient = contains(app.type_study, 'Transient');
            if isTransient
                if app.End_time <= 0 || app.Num_steps < 2
                    uialert(app.UIFigure, ...
                        'End time must be positive and there must be at least 2 time steps.', ...
                        'Invalid time settings');
                    return
                end
                tlist = linspace(0, app.End_time, app.Num_steps);
            else
                tlist = 0;   % placeholder, unused
            end
 
            F = app.Force_val;
            cla(app.UIAxes)
            setSliderEnabled(app, false)
            d = uiprogressdlg(app.UIFigure, 'Title', 'Solving', ...
                'Message', 'Meshing and solving...', 'Indeterminate', 'on');
            cleanup = onCleanup(@() close(d));   %#ok<NASGU>
 
            try
                switch app.type_study
 
                    % ---------- STRUCTURAL STATIC ----------
                    case 'Structural (Static)'
                        model = createpde('structural', 'static-solid');
                        model.Geometry = app.Geometry;
                        generateMesh(model);
                        structuralProperties(model, ...
                            'YoungsModulus', app.Elastic_mod, ...
                            'PoissonsRatio', app.Poission);
                        structuralBC(model, 'Face', 3, 'Constraint', 'fixed');
                        applyStructuralLoad(app, model, F, false);
                        sol = solve(model);
                        resultData = sol.VonMisesStress;
                        label = 'Structural Static - von Mises Stress (Pa)';
 
                    % ---------- STRUCTURAL TRANSIENT ----------
                    case 'Structural (Transient)'
                        model = createpde('structural', 'transient-solid');
                        model.Geometry = app.Geometry;
                        generateMesh(model);
                        % Transient needs mass density for the inertia term
                        structuralProperties(model, ...
                            'YoungsModulus', app.Elastic_mod, ...
                            'PoissonsRatio', app.Poission, ...
                            'MassDensity',   app.Mass_density);
                        structuralBC(model, 'Face', 3, 'Constraint', 'fixed');
                        applyStructuralLoad(app, model, F, app.Use_sine);
                        % Start from rest
                        structuralIC(model, ...
                            'Displacement', [0; 0; 0], ...
                            'Velocity',     [0; 0; 0]);
                        sol = solve(model, tlist);
                        % For a transient result this is nodes x timesteps
                        resultData = evaluateVonMisesStress(sol);
                        label = 'Structural Transient - von Mises Stress (Pa)';
 
                    % ---------- THERMAL STEADY STATE ----------
                    case 'Thermal (Steady State)'
                        if any(isnan([app.Flux, app.Conv, app.Ambient_temp]))
                            uialert(app.UIFigure, ...
                                'Enter valid heat flux, convection coefficient, and ambient temperature.', ...
                                'Missing thermal inputs');
                            return
                        end
                        model = createpde('thermal', 'steadystate');
                        model.Geometry = app.Geometry;
                        generateMesh(model);
                        thermalProperties(model, ...
                            'ThermalConductivity', app.Thermal_conduc);
                        thermalBC(model, 'Face', 3, 'HeatFlux', app.Flux);
                        thermalBC(model, 'Face', [1 5 6 7], ...
                            'ConvectionCoefficient', app.Conv, ...
                            'AmbientTemperature', app.Ambient_temp);
                        sol = solve(model);
                        resultData = sol.Temperature;
                        label = 'Thermal Steady State - Temperature (\circC)';
 
                    % ---------- THERMAL TRANSIENT ----------
                    case 'Thermal (Transient)'
                        if any(isnan([app.Flux, app.Conv, app.Ambient_temp, app.Initial_temp]))
                            uialert(app.UIFigure, ...
                                'Enter valid heat flux, convection coefficient, ambient and initial temperature.', ...
                                'Missing thermal inputs');
                            return
                        end
                        model = createpde('thermal', 'transient');
                        model.Geometry = app.Geometry;
                        generateMesh(model);
                        % Transient needs density and specific heat for the
                        % thermal capacitance term
                        thermalProperties(model, ...
                            'ThermalConductivity', app.Thermal_conduc, ...
                            'MassDensity',         app.Mass_density, ...
                            'SpecificHeat',        app.Specific_heat);
                        thermalBC(model, 'Face', 3, 'HeatFlux', app.Flux);
                        thermalBC(model, 'Face', [1 5 6 7], ...
                            'ConvectionCoefficient', app.Conv, ...
                            'AmbientTemperature', app.Ambient_temp);
                        thermalIC(model, app.Initial_temp);
                        sol = solve(model, tlist);
                        resultData = sol.Temperature;
                        label = 'Thermal Transient - Temperature (\circC)';
                end
            catch ME
                uialert(app.UIFigure, ME.message, 'Solve failed');
                return
            end
 
            % Cache the solution so the slider can scrub without re-solving
            app.Sol_data  = resultData;
            app.Sol_model = model;
            app.Sol_tlist = tlist;
            app.Sol_label = label;
 
            if isTransient && size(resultData, 2) > 1
                nT = size(resultData, 2);
                app.TimeStepSlider.Limits = [1 nT];
                app.TimeStepSlider.Value  = nT;
                app.TimeStepSlider.MajorTicks = round(linspace(1, nT, 5));
                setSliderEnabled(app, true)
                renderSolution(app, nT)     % show the final state first
            else
                setSliderEnabled(app, false)
                renderSolution(app, 1)
            end
        end
 
        % Apply the structural load, optionally time-varying
        function applyStructuralLoad(app, model, F, useSine)
            omega = 2 * pi * app.Load_freq;
            switch app.L_type
                case 'Point Load'
                    if useSine
                        structuralBoundaryLoad(model, 'Vertex', [3 2], ...
                            'Force', @(location, state) ...
                            [0; 0; -F * sin(omega * state.time)]);
                    else
                        structuralBoundaryLoad(model, 'Vertex', [3 2], ...
                            'Force', [0; 0; -F]);
                    end
                case 'Distributed Load'
                    if useSine
                        structuralBoundaryLoad(model, 'Face', 5, ...
                            'SurfaceTraction', @(location, state) ...
                            [0; 0; -F * sin(omega * state.time)] ...
                            .* ones(1, numel(location.x)));
                    else
                        structuralBoundaryLoad(model, 'Face', 5, ...
                            'SurfaceTraction', [0; 0; -F]);
                    end
            end    
        end

        % Value changed function: MaterialDropDown
        function MaterialDropDownValueChanged(app, event)
            app.Material = app.MaterialDropDown.Value;
            switch app.Material
                case 'Stainless Steel'
                    nu = 0.25;  E = 190e9;  K = 16.2;
                case 'Brass'
                    nu = 0.34;  E = 97e9;   K = 115;
                case 'Aluminium'
                    nu = 0.33;  E = 68e9;   K = 237;
                otherwise
                    return
            end
            app.Elastic_mod    = E;
            app.Poission       = nu;
            app.Thermal_conduc = K;
        end

