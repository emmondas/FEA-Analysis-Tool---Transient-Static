        % Button pushed function: UploadSTLFileButton
        function UploadSTLFileButtonPushed(app, event)
           [file, path] = uigetfile('*.stl', 'Select an STL file');
            figure(app.UIFigure)
            if isequal(file, 0)
                return
            end
            try
                app.Geometry = importGeometry(fullfile(path, file));
                % If your STL is in millimeters, uncomment to convert to meters:
                % app.Geometry = scale(app.Geometry, 1e-3);
            catch ME
                uialert(app.UIFigure, ME.message, 'STL import failed');
                return
            end

             app.Sol_data = [];
            setSliderEnabled(app, false)
 
            cla(app.UIAxes)
            tempFig = figure('Visible', 'off');
            pdegplot(app.Geometry, 'FaceLabels', 'on', 'FaceAlpha', 0.5);
            copyobj(allchild(tempFig.CurrentAxes), app.UIAxes);
            close(tempFig)
            view(app.UIAxes, 45, 45)
            axis(app.UIAxes, 'equal')
            title(app.UIAxes, 'Imported Geometry (check face labels)')
        end

