    methods (Access = private)
      % Show/hide transient controls to match the selected study
        function updateTransientVisibility(app)
            isTransient = contains(app.type_study, 'Transient');
            isThermal   = contains(app.type_study, 'Thermal');
 
            app.Panel.Visible = matlab.lang.OnOffSwitchState(isTransient);
 
            % Thermal-only transient controls
            tOn = matlab.lang.OnOffSwitchState(isTransient && isThermal);
            app.InitialTempEditField.Visible      = tOn;
            app.InitialTempEditFieldLabel.Visible = tOn;
 
            % Structural-only transient controls
            sOn = matlab.lang.OnOffSwitchState(isTransient && ~isThermal);
            app.SinusoidalLoadCheckBox.Visible      = sOn;
            app.LoadFrequencyEditField.Visible      = sOn;
            app.LoadFrequencyEditFieldLabel.Visible = sOn;
            app.LoadFrequencyEditField.Enable = ...
                matlab.lang.OnOffSwitchState(isTransient && ~isThermal && app.Use_sine);
 
            % Structural inputs only matter for structural studies
            sInputs = matlab.lang.OnOffSwitchState(~isThermal);
            app.ForceMagnitudeNEditField.Enable = sInputs;
            app.LoadTypeButtonGroup.Enable      = sInputs;
 
            % Thermal inputs only matter for thermal studies
            thInputs = matlab.lang.OnOffSwitchState(isThermal);
            app.HeatFluxWm2EditField_2.Enable         = thInputs;
            app.ConvectionCoeffEditField_2.Enable     = thInputs;
            app.OutsideTemperatureCEditField_2.Enable = thInputs;
        end
 
        % Show or hide the time-step slider
        function setSliderEnabled(app, tf)
            state = matlab.lang.OnOffSwitchState(tf);
            app.TimeStepSlider.Visible      = state;
            app.TimeStepSliderLabel.Visible = state;
            app.TimeStepSlider.Enable       = state;
        end
 
        % Draw one time step of the cached solution into the app axes
        function renderSolution(app, idx)
            if isempty(app.Sol_data)
                return
            end
            idx = max(1, min(idx, size(app.Sol_data, 2)));
 
            cla(app.UIAxes)
            % pdeplot3D cannot target a UIAxes directly, so plot into a
            % hidden figure and re-parent the graphics
            tempFig = figure('Visible', 'off');
            h = pdeplot3D(app.Sol_model, 'ColorMapData', app.Sol_data(:, idx));
            h(2).Parent.Parent = app.UIAxes;
            close(tempFig)
 
            view(app.UIAxes, 45, 45)
            colormap(app.UIAxes, 'turbo')
            colorbar(app.UIAxes)
            axis(app.UIAxes, 'equal')
 
            if isscalar(app.Sol_tlist)
                title(app.UIAxes, app.Sol_label)
            else
                title(app.UIAxes, sprintf('%s  |  t = %.4g s', ...
                    app.Sol_label, app.Sol_tlist(idx)))
            end
        end
    end
    

